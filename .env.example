# Frontend build configuration for Create React App.
# Copy to .env.local (gitignored) and adjust. Only REACT_APP_* names are exposed
# to the bundle.
#
# Everything here ends up inside the JavaScript served to the browser. Never put
# a real secret in this file — the JWT signing key, database credentials and any
# other true secret belong in backend/config.json.

# Serve the dev server over HTTPS. Set here rather than in the npm start script,
# where "set HTTPS=true&&..." only worked in Windows cmd and broke the script on
# macOS and Linux.
HTTPS=true

# Where the API lives.
REACT_APP_API_URL=https://localhost:9001/

# Must match one entry of "keys" in backend/config.json. This is a deployment
# gate, not an authentication control.
REACT_APP_API_KEY=
